{
  "schema_version": 1,
  "zone": "hhaus.org",
  "origin_policy": {
    "cluster_public_entrypoint": "cloudflare-tunnel-only",
    "admin_entrypoint": "private-network-only",
    "admin_public_hostnames_allowed": false,
    "public_raw_tcp_allowed": false,
    "direct_public_origin": false
  },
  "cloudflare_edge_contract": {
    "minimum_tls_version": "1.2",
    "always_use_https": true,
    "tls_1_3": true,
    "city_redirect_status_code": 308,
    "city_redirect_preserves_query_string": true,
    "city_redirect_match": "exact-host",
    "worker_routes": false
  },
  "hosts": [
    {
      "hostname": "hhaus.org",
      "purpose": "public-marketing-and-anonymous-intake",
      "edge": "github-pages",
      "state": "live",
      "dns": {
        "type": "CNAME",
        "target": "hhaus-org.github.io",
        "proxied": false
      },
      "routes": [
        "/",
        "/submit-pre-interest",
        "/submit-application"
      ]
    },
    {
      "hostname": "www.hhaus.org",
      "purpose": "marketing-alias",
